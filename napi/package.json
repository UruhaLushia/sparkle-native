{
  "name": "@uruhalushia/sparkle-native",
  "version": "0.1.0",
  "description": "Sparkle native bridge",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "packageManager": "pnpm@11.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UruhaLushia/sparkle-native.git"
  },
  "homepage": "https://github.com/UruhaLushia/sparkle-native",
  "bugs": {
    "url": "https://github.com/UruhaLushia/sparkle-native/issues"
  },
  "license": "GPL-3.0-only",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "sparkle-native.*.node"
  ],
  "napi": {
    "binaryName": "sparkle-native",
    "targets": [
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "loongarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --strip --no-js --dts napi.generated.d.ts",
    "build:debug": "napi build --platform --no-js --dts napi.generated.d.ts",
    "create-npm-dirs": "napi create-npm-dirs",
    "artifacts": "napi artifacts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  }
}
